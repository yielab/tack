# Example environment file for the tack-runner systemd unit
# (packaging/systemd/tack-runner.service). Copy to
# /etc/tack-runner/tack-runner.env, fill in real values, then:
#   chmod 600 /etc/tack-runner/tack-runner.env
#   chown tack-runner:tack-runner /etc/tack-runner/tack-runner.env
#
# Full variable reference: docs/CONFIG.md ("tack-runner binary" table).
# Never commit a filled-in copy of this file — it holds a live credential.

# Tack API base URL the runner polls (the runner-protocol surface, not the
# operator API). Required.
TACK_RUNNER_API_URL=https://tack.example.com/api/runner/v1

# One-time operator-issued enrollment token. Exchanged for a durable
# credential on first successful enroll and never persisted in this form —
# crates/tack-runner/src/config.rs's EnrollmentCredential is redacted in every
# log, Debug impl and error. Required for first start.
TACK_RUNNER_ENROLLMENT_TOKEN=

# Stable identifier this runner reports to the control plane. Defaults to
# "local-runner"; set something unique per machine before enrolling more than
# one runner against the same Tack instance.
TACK_RUNNER_ID=

# Left unset here: the unit's own Environment= line pins this to
# /var/lib/tack-runner (systemd's StateDirectory=), which already matches the
# "owner-only directory for the journal and credential" contract. Override
# only if you know you need a different path.
# TACK_RUNNER_STATE_DIR=/var/lib/tack-runner
