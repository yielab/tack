#!/bin/sh
# Fake `docket` binary for the e2e webServer's PATH — see ./claude's header.
# It shadows a real docket installed on the machine running the suite, so
# nothing the suite starts reaches the operator's own install or home. The
# runner talks to docket over HTTP, so a binary here is only ever asked its
# version.
echo "docket 9.9.4"
exit 0
