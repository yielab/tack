{
  "name": "frontend",
  "private": true,
  "version": "0.1.0-beta.10",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "type-check": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "lint:tokens": "bash scripts/check-tokens.sh",
    "gen:api": "openapi-typescript ../docs/openapi.json -o src/shared/api/schema.gen.ts"
  },
  "dependencies": {
    "@fontsource/caprasimo": "^5.3.0",
    "@fontsource/figtree": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@solidjs/router": "^1.0.0",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-shell": "^2.4.1",
    "@thisbeyond/solid-dnd": "^0.7.5",
    "clsx": "^2.1.1",
    "solid-icons": "^1.2.0",
    "solid-js": "^1.9.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^26.6.2",
    "autoprefixer": "^10.6.1",
    "jsdom": "^30.1.1",
    "openapi-typescript": "^7.9.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.0",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^4.1.11"
  }
}
