{
  "protocol_version": 1,
  "states": [
    "queued",
    "leased",
    "preparing",
    "running",
    "waiting_decision",
    "succeeded",
    "failed",
    "cancelled",
    "lost",
    "needs_operator"
  ],
  "terminal_states": ["succeeded", "failed", "cancelled"],
  "rules": [
    {
      "from": "queued",
      "allow": {
        "leased": ["scheduler"],
        "cancelled": ["operator"]
      },
      "deny": ["queued", "preparing", "running", "waiting_decision", "succeeded", "failed", "lost", "needs_operator"]
    },
    {
      "from": "leased",
      "allow": {
        "preparing": ["lease_owner"],
        "failed": ["lease_owner"],
        "cancelled": ["lease_owner"],
        "lost": ["recovery_service"],
        "needs_operator": ["recovery_service"]
      },
      "deny": ["queued", "leased", "running", "waiting_decision", "succeeded"]
    },
    {
      "from": "preparing",
      "allow": {
        "running": ["lease_owner"],
        "failed": ["lease_owner"],
        "cancelled": ["lease_owner"],
        "lost": ["recovery_service"],
        "needs_operator": ["recovery_service"]
      },
      "deny": ["queued", "leased", "preparing", "waiting_decision", "succeeded"]
    },
    {
      "from": "running",
      "allow": {
        "waiting_decision": ["lease_owner"],
        "succeeded": ["lease_owner"],
        "failed": ["lease_owner"],
        "cancelled": ["lease_owner"],
        "lost": ["recovery_service"],
        "needs_operator": ["recovery_service"]
      },
      "deny": ["queued", "leased", "preparing", "running"]
    },
    {
      "from": "waiting_decision",
      "allow": {
        "running": ["lease_owner"],
        "succeeded": ["lease_owner"],
        "failed": ["lease_owner"],
        "cancelled": ["lease_owner"],
        "lost": ["recovery_service"],
        "needs_operator": ["recovery_service"]
      },
      "deny": ["queued", "leased", "preparing", "waiting_decision"]
    },
    {
      "from": "succeeded",
      "allow": {},
      "deny": ["queued", "leased", "preparing", "running", "waiting_decision", "succeeded", "failed", "cancelled", "lost", "needs_operator"]
    },
    {
      "from": "failed",
      "allow": {},
      "deny": ["queued", "leased", "preparing", "running", "waiting_decision", "succeeded", "failed", "cancelled", "lost", "needs_operator"]
    },
    {
      "from": "cancelled",
      "allow": {},
      "deny": ["queued", "leased", "preparing", "running", "waiting_decision", "succeeded", "failed", "cancelled", "lost", "needs_operator"]
    },
    {
      "from": "lost",
      "allow": {
        "queued": ["recovery_service", "operator"],
        "failed": ["operator"]
      },
      "deny": ["leased", "preparing", "running", "waiting_decision", "succeeded", "cancelled", "lost", "needs_operator"]
    },
    {
      "from": "needs_operator",
      "allow": {
        "queued": ["operator"],
        "failed": ["operator"]
      },
      "deny": ["leased", "preparing", "running", "waiting_decision", "succeeded", "cancelled", "lost", "needs_operator"]
    }
  ],
  "replay_rule": "A byte-equivalent report with the same idempotency key returns the original success without invoking the transition validator",
  "recovery_observation": {
    "actor": "recovery_service",
    "idempotency_key": "recovery_key",
    "observations": ["process_stopped", "process_running", "ambiguous"],
    "details": {
      "journal_state": "non_secret_runner_journal_state",
      "process_observed": "boolean"
    },
    "dispositions": {
      "safe_pre_spawn_requeue": {
        "allowed_from": ["leased", "preparing", "running", "waiting_decision"],
        "requires": ["observation=process_stopped", "authoritative_process_absent", "authoritative_started_at_absent"],
        "attempt_transition": "lost",
        "request_transition": "queued"
      },
      "needs_operator": {
        "allowed_from": ["leased", "preparing", "running", "waiting_decision"],
        "requires": ["authoritative_process_absence_not_proven_or_observation_is_process_running_or_ambiguous"],
        "attempt_transition": "needs_operator",
        "request_transition": "needs_operator"
      },
      "already_terminal": {
        "allowed_from": ["succeeded", "failed", "cancelled"],
        "requires": ["no_state_transition"],
        "attempt_transition": "none",
        "request_transition": "none"
      }
    },
    "authority": "Server disposition is determined from the authenticated runner/fence and authoritative attempt state. Runner details are audit evidence only and cannot justify safe requeue.",
    "replay_rule": "The same recovery_key with a byte-equivalent request returns the original disposition and committed_at. Reusing the key with different observation or details returns idempotency_conflict without transition."
  }
}
