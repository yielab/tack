{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "plan-v1/schema.json",
  "title": "Planner proposal (tack-plan.json)",
  "type": "object",
  "required": ["v", "subtasks"],
  "properties": {
    "v": {"const": "1"},
    "subtasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "description"],
        "properties": {
          "title": {"type": "string", "minLength": 1},
          "description": {"type": "string"},
          "acceptance": {"type": "array", "items": {"type": "string"}, "default": []},
          "depends_on": {"type": "array", "items": {"type": "integer", "minimum": 0}, "default": [], "description": "Indexes into subtasks."},
          "estimate": {"enum": ["S", "M", "L"]},
          "type": {"type": "string", "description": "The item type the entry becomes, when the project has it; else the item's own."},
          "role": {"type": "string", "description": "A project role, by name."},
          "team": {"type": "string", "description": "A team, by name; the one profile that names it does the entry."},
          "parent": {"type": "integer", "minimum": 0, "description": "Index of an earlier entry this one is a sub-item of."}
        }
      }
    }
  }
}
