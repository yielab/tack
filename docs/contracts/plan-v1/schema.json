{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "plan-v1/schema.json",
  "title": "Planner proposal (tack-plan.json)",
  "type": "object",
  "required": ["v", "subtasks"],
  "properties": {
    "v": {"const": "1"},
    "subtasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "description"],
        "properties": {
          "title": {"type": "string", "minLength": 1},
          "description": {"type": "string"},
          "acceptance": {"type": "array", "items": {"type": "string"}, "default": []},
          "depends_on": {"type": "array", "items": {"type": "integer", "minimum": 0}, "default": [], "description": "Indexes into subtasks."},
          "estimate": {"enum": ["S", "M", "L"]}
        }
      }
    }
  }
}
