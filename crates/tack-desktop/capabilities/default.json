{
  "$schema": "../../../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window's local capabilities: core defaults, the one sidecar this app ever spawns, and message dialogs. The window never loads local content.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/tack",
          "sidecar": true,
          "args": [
            "serve",
            "--with-runner"
          ]
        }
      ]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/tack",
          "sidecar": true,
          "args": [
            "serve",
            "--with-runner"
          ]
        }
      ]
    },
    "dialog:allow-message"
  ]
}
