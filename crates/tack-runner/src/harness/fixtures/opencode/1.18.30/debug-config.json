   "git log*": "allow",
   "git show*": "allow",
   "git branch*": "allow",
   "git remote*": "allow",
   "git stash list*": "allow",
   "gh pr view*": "allow",
   "gh pr list*": "allow",
   "gh issue view*": "allow",
   "gh issue list*": "allow",
