   "**/.ssh/**": "deny",
   "**/*.pem": "deny",
   "**/*.key": "deny"
  },
  "bash": {
   "*": "ask",
   "ls*": "allow",
   "cat *": "allow",
   "head *": "allow",
   "tail *": "allow",
   "wc *": "allow",
   "rg *": "allow",
   "fd *": "allow",
   "which *": "allow",
   "git status*": "allow",
