codex -c model_provider=tack_provider -c 'model_providers.tack_provider.name="tack loopback"' -c 'model_providers.tack_provider.base_url="http://127.0.0.1:8941/v1"' -c 'model_providers.tack_provider.env_key="FAKE_API_KEY"' -c 'model_providers.tack_provider.wire_api="responses"' exec --json --model fake-model --skip-git-repo-check --dangerously-bypass-approvals-and-sandbox "write a file"
