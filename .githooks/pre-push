#!/usr/bin/env bash
set -e

# rust-toolchain.toml only binds a `cargo` that is rustup's proxy. A distro or
# Homebrew cargo earlier on PATH ignores the pin and runs whatever version it
# is, and this gate then judges the tree with lints CI never sees — or misses
# ones it does. Put rustup's proxies first, then check that the pin took.
if command -v rustup >/dev/null 2>&1; then
  PATH="$(dirname "$(command -v rustup)"):$PATH"
  export PATH
fi
pinned=$(sed -n 's/^channel *= *"\(.*\)".*/\1/p' rust-toolchain.toml)
if ! cargo --version | grep -q "^cargo $pinned "; then
  echo "cargo on PATH is '$(cargo --version)', not the pinned $pinned from rust-toolchain.toml;" >&2
  echo "install rustup (https://rustup.rs) so the pin applies, or put its ~/.cargo/bin first on PATH" >&2
  exit 1
fi

echo "→ cargo fmt --all --check"
cargo fmt --all --check
# `--all` means the workspace, and tack-desktop is deliberately not in it, so this
# is the only local check that sees that crate at all. Formatting needs no build,
# unlike the clippy pass below, which is why CI keeps that half and this does not.
cargo fmt --manifest-path crates/tack-desktop/Cargo.toml --all --check

echo "→ cargo clippy --workspace --all-targets -- -D warnings"
cargo clippy --workspace --all-targets -- -D warnings

# A merge can leave a derived file describing the tree as it was on one side of
# it. CI's `openapi_contract` test catches the spec; nothing caught a stale
# lockfile or a stale TypeScript schema, and both are cheap to check here.
echo "→ generated files are current"
for manifest in Cargo.toml crates/tack-desktop/Cargo.toml; do
  if ! cargo metadata --locked --format-version 1 --manifest-path "$manifest" >/dev/null 2>&1; then
    echo "  the lockfile for $manifest is out of date — run ./scripts/regen-generated.sh" >&2
    exit 1
  fi
done
if [ -d frontend/node_modules ]; then
  npm --prefix frontend run gen:api >/dev/null
  if ! git diff --quiet -- frontend/src/shared/api/schema.gen.ts; then
    echo "  schema.gen.ts was stale — it has just been regenerated; commit the result" >&2
    exit 1
  fi
fi

python3 scripts/gen-api-reference.py >/dev/null
if ! git diff --quiet -- docs/book/src/developer/api-reference.md; then
  echo "  developer/api-reference.md was stale — it has just been regenerated; commit the result" >&2
  exit 1
fi

echo "✓ pre-push checks passed"
