# Caddy configuration for FlexPM local development
# Smart multi-app environment - uses port 9000 to avoid conflicts

# FlexPM on port 9000 (HTTP) - multi-app friendly
http://localhost:9000, http://flexpm.local:9000 {
    # API routes go to backend
    handle /api/* {
        reverse_proxy flexpm:3210
    }

    # WebSocket endpoint for board live updates
    handle /ws/* {
        reverse_proxy flexpm:3210 {
            # WebSocket headers
            header_up Connection {>Connection}
            header_up Upgrade {>Upgrade}
        }
    }

    # All other routes go to frontend
    handle /* {
        reverse_proxy frontend:80
    }

    # Enable CORS for development
    header {
        Access-Control-Allow-Origin *
        Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
        Access-Control-Allow-Headers "Content-Type, Authorization"
    }

    # Handle CORS preflight requests
    @options {
        method OPTIONS
    }
    respond @options 204

    # Logging
    log {
        output stdout
        format console
        level INFO
    }
}

# HTTPS version on port 9443 with self-signed cert
https://localhost:9443, https://flexpm.local:9443 {
    # Self-signed certificate for local development
    tls internal

    # API routes go to backend
    handle /api/* {
        reverse_proxy flexpm:3210
    }

    # WebSocket endpoint for board live updates
    handle /ws/* {
        reverse_proxy flexpm:3210 {
            # WebSocket headers
            header_up Connection {>Connection}
            header_up Upgrade {>Upgrade}
        }
    }

    # All other routes go to frontend
    handle /* {
        reverse_proxy frontend:80
    }

    # Enable CORS for development
    header {
        Access-Control-Allow-Origin *
        Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
        Access-Control-Allow-Headers "Content-Type, Authorization"
    }

    # Handle CORS preflight requests
    @options {
        method OPTIONS
    }
    respond @options 204

    # Logging
    log {
        output stdout
        format console
        level INFO
    }
}
