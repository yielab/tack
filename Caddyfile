# Caddy configuration for Tack with custom domain support
# Uses dnsmasq for automatic *.test domain resolution
# Ports 9000/9443 to avoid conflicts in multi-app environments

# Tack custom domain - HTTP
http://tack.test:9000 {
    # API routes go to backend
    handle /api/* {
        reverse_proxy tack:3210
    }

    # WebSocket endpoint for board live updates
    handle /ws/* {
        reverse_proxy tack:3210 {
            # WebSocket headers
            header_up Connection {>Connection}
            header_up Upgrade {>Upgrade}
        }
    }

    # All other routes go to frontend
    handle /* {
        reverse_proxy frontend:80
    }

    # Enable CORS for development
    header {
        Access-Control-Allow-Origin *
        Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
        Access-Control-Allow-Headers "Content-Type, Authorization"
    }

    # Handle CORS preflight requests
    @options {
        method OPTIONS
    }
    respond @options 204

    # Logging
    log {
        output stdout
        format console
        level INFO
    }
}

# Tack custom domain - HTTPS with self-signed certificate
https://tack.test:9443 {
    # Self-signed certificate for .test domain
    tls internal

    # API routes go to backend
    handle /api/* {
        reverse_proxy tack:3210
    }

    # WebSocket endpoint for board live updates
    handle /ws/* {
        reverse_proxy tack:3210 {
            # WebSocket headers
