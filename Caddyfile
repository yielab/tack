# Caddy configuration for FlexPM local development
# Provides custom domain access at flexpm.local

flexpm.local {
    # API routes go to backend
    handle /api/* {
        reverse_proxy flexpm:3210
    }

    # WebSocket endpoint for board live updates
    handle /ws/* {
        reverse_proxy flexpm:3210
    }

    # All other routes go to frontend
    handle /* {
        reverse_proxy frontend:80
    }

    # Enable CORS for development
    header {
        Access-Control-Allow-Origin *
        Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
        Access-Control-Allow-Headers "Content-Type, Authorization"
    }

    # Handle CORS preflight requests
    @options {
        method OPTIONS
    }
    respond @options 204

    # Logging
    log {
        output stdout
        format json
        level INFO
    }
}

# HTTP redirect to HTTPS (Caddy auto-generates self-signed cert for .local)
http://flexpm.local {
    redir https://flexpm.local{uri}
}
